<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">

  <!-- Grundlegende Metadaten -->
  <Id>a1b2c3d4-e5f6-7890-abcd-ef1234567890</Id>
  <Version>1.4.0.0</Version>
  <ProviderName>BLOCKBRAIN</ProviderName>
  <DefaultLocale>de-DE</DefaultLocale>
  <DisplayName DefaultValue="BLOCKBRAIN Outlook Plugin" />
  <Description DefaultValue="BLOCKBRAIN AI generiert automatisch E-Mail-Antworten." />
  <IconUrl DefaultValue="https://ebbonaut.github.io/bb-outlook-plugin/assets/icon-64.png" />
  <HighResolutionIconUrl DefaultValue="https://ebbonaut.github.io/bb-outlook-plugin/assets/icon-128.png" />
  <SupportUrl DefaultValue="https://blockbrain.ai" />

  <!-- Outlook-Anforderungen -->
  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1" />
    </Sets>
  </Requirements>

  <!-- Fallback-Regel (wird von VersionOverrides überschrieben) -->
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://ebbonaut.github.io/bb-outlook-plugin/taskpane.html" />
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteMailbox</Permissions>
  <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />

  <!-- VersionOverrides: Hier wird der Button im Header definiert -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides"
                    xsi:type="VersionOverridesV1_0">

    <Requirements>
      <bt:Sets DefaultMinVersion="1.5">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>

    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>

          <FunctionFile resid="Taskpane.Url" />

          <!-- Button im E-Mail-Lesen-Header -->
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="bbGroup">
                <Label resid="GroupLabel" />

                <Control xsi:type="Button" id="bbDraftButton">
                  <Label resid="ButtonLabel" />
                  <Supertip>
                    <Title resid="ButtonLabel" />
                    <Description resid="ButtonTooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>

              </Group>
            </OfficeTab>
          </ExtensionPoint>

        </DesktopFormFactor>
      </Host>
    </Hosts>

    <!-- Ressourcen -->
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://ebbonaut.github.io/bb-outlook-plugin/assets/icon-16.png" />
        <bt:Image id="Icon.32x32" DefaultValue="https://ebbonaut.github.io/bb-outlook-plugin/assets/icon-32.png" />
        <bt:Image id="Icon.80x80" DefaultValue="https://ebbonaut.github.io/bb-outlook-plugin/assets/icon-80.png" />
      </bt:Images>

      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://ebbonaut.github.io/bb-outlook-plugin/taskpane.html" />
      </bt:Urls>

      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="BLOCKBRAIN" />
        <bt:String id="ButtonLabel" DefaultValue="BLOCKBRAIN" />
      </bt:ShortStrings>

      <bt:LongStrings>
        <bt:String id="ButtonTooltip" DefaultValue="KI-generierte E-Mail-Antwort mit BLOCKBRAIN erstellen" />
      </bt:LongStrings>
    </Resources>

  </VersionOverrides>
</OfficeApp>

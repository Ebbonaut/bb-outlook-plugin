{
  "name": "bb-outlook-plugin",
  "version": "1.0.0",
  "description": "BlockBrain AI Email Draft Outlook Add-in",
  "private": true,
  "scripts": {
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production",
    "start": "webpack serve --mode development",
    "deploy": "npm run build && gh-pages -d dist",
    "validate": "office-addin-manifest validate manifest.xml",
    "sideload": "office-addin-dev-certs install && office-addin-debugging start manifest.xml"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^6.10.0",
    "gh-pages": "^6.1.0",
    "html-webpack-plugin": "^5.6.0",
    "office-addin-debugging": "^5.1.0",
    "office-addin-dev-certs": "^1.13.0",
    "office-addin-manifest": "^1.13.0",
    "sharp": "^0.34.5",
    "style-loader": "^3.3.4",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.0"
  }
}
